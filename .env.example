# Groq — required. Every production roast uses this (GPT-OSS 120B, Groq's free tier —
# no credit card, rate-limited rather than metered). This is the only model production
# users can get; the in-UI model picker only exists in development.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Apify — required for Instagram scraping only (not needed for GitHub, LinkedIn, or
# resume — LinkedIn is PDF upload/paste, not scraped, since the Apify LinkedIn actor
# never worked against LinkedIn's unauthenticated-request blocking).
# Get a token at https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# Upstash Redis — required for rate limiting (3 roasts/day anonymous, 15/day signed in)
# and scrape caching. Get these from a Redis database at https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Instagram kill switch — optional, defaults to enabled. Set to "false" (only the
# literal string disables it) to hide the Instagram source in the UI and reject
# instagram requests server-side with a clean "temporarily unavailable" error, without
# a deploy — Instagram is the app's only remaining scraping dependency (LinkedIn moved
# to PDF upload), so this exists to turn it off fast if the Apify actor breaks.
INSTAGRAM_ENABLED=

# Set to "development" to (a) include the raw scraped profile data in /api/roast
# responses, and (b) enable the dev-only model picker (GPT-4o vs GPT-OSS 120B) in the
# UI — see resolveProductionSafeModelOption in api/roast.js. Leave unset in production.
NODE_ENV=

# OpenAI — optional, dev-only. Only used if NODE_ENV=development and you pick GPT-4o
# from the dev model picker to compare against the Groq default; also used by
# scripts/eval-models.mjs as the comparison baseline. Not needed otherwise.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Supabase — optional. Powers sign-in (GitHub + Google OAuth) and persistence of roast
# history. The app works fully anonymous-only when these are absent (a fork, or local
# dev without a project) — never required to boot. See CLAUDE.md's "Auth & data" section
# and supabase/migrations/ for the schema these support.

# Client-side — safe to expose to the browser bundle (VITE_ prefix). The anon key is
# public by design; RLS policies in supabase/migrations/ are what actually protect data.
# Get these from your Supabase project settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only — NEVER add a VITE_ prefix to this one, or it ships to the client bundle.
# Used to verify JWTs (api/_lib/auth.js) and to persist roasts (api/_lib/persistRoast.js),
# bypassing RLS deliberately — the server always derives user_id from the verified JWT
# itself, never from client input. Get it from your Supabase project settings → API.
SUPABASE_SERVICE_ROLE_KEY=

# Sentry — optional, server-only error tracking (api/_lib/sentry.js). Absent means Sentry
# is simply off: no crash, no degraded behavior, every failure path still logs to the
# console exactly as before. Only error codes/types/models/stack traces are ever sent —
# never scraped profile content, resume text, roast text, or emails. Create a project at
# https://sentry.io, pick "Node.js" (not Next.js/Vercel — this isn't using either
# integration), and paste its DSN here.
SENTRY_DSN=
