# OpenAI — required for the default GPT-4o model option.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Apify — required for LinkedIn and Instagram scraping (not needed for GitHub or resume).
# Get a token at https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# Upstash Redis — required for rate limiting (5 roasts/hour/IP) and scrape caching.
# Get these from a Redis database at https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set to "development" to include the raw scraped profile data in /api/roast
# responses, for local debugging. Leave unset in production.
NODE_ENV=

# OpenRouter — required for the Command A / Command R model options (the in-UI model
# switch next to Severity). Also used by scripts/eval-models.mjs for comparing
# candidates against the gpt-4o baseline (see ROASTIFY_TASKS.md section 4). Not needed
# if you only ever use the default GPT-4o option. Get a key at
# https://openrouter.ai/keys — pay-per-token, no subscription, credits don't expire.
OPENROUTER_API_KEY=
