{
  "regions": ["sin1"],
  "functions": {
    "api/roast.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/purge-expired-profile-data", "schedule": "0 3 * * *" }
  ]
}